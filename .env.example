# businessfind — copy this file to .env and fill in what you need.
#
#   cp .env.example .env
#
# The server boots fine with NO .env at all: it serves the whole UI, accounts,
# friends, check-ins and saved places, and the Google-backed endpoints
# (/api/nearby, /api/place, /api/geocode, /api/photo) return a clean 503.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE YOU PASTE A BILLABLE KEY. The difference between running
# this app for $0/month and $615/month is entirely in the four caps below plus
# one quota you must set in the Cloud Console by hand.
# ---------------------------------------------------------------------------


# --- server ---------------------------------------------------------------

PORT=4321

# Absolute origin used for canonical tags, og:url, sitemap.xml and robots.txt.
# Set this to your real https origin in production or search engines will index
# localhost URLs. Defaults to http://localhost:$PORT.
SITE_ORIGIN=http://localhost:4321

# Set to 1 when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=0


# --- Google keys ----------------------------------------------------------
#
# You need a Google Cloud project with billing enabled and these APIs on:
#   Places API (New), Maps JavaScript API, Geocoding API
# https://console.cloud.google.com/google/maps-apis

# SERVER key: used only inside the Node process, for the Places (New) API, the
# Geocoding API and the Places photo proxy. It is NEVER sent to the browser.
# Do not restrict it by HTTP referrer (a server sends none) — restrict it by IP
# address, and restrict it to exactly: Places API (New) + Geocoding API.
GOOGLE_PLACES_SERVER_KEY=

# BROWSER key: shipped to the client (via /api/config) to load the Maps
# JavaScript API. Restrict it by HTTP referrer to your own domain(s) and to
# exactly: Maps JavaScript API. Because it is referrer-restricted it CANNOT
# fetch Places photos — that is why photos go through /api/photo instead.
#
# If this is blank, /api/config reports mapEnabled:false and the client falls
# back to the list view instead of receiving an empty key string.
GOOGLE_MAPS_BROWSER_KEY=


# --- daily budget caps (the whole cost story) ------------------------------
#
# Each cap is a hard per-day count, shared across all users, enforced in-process
# BEFORE any request is made to Google. 0 DISABLES that endpoint entirely (it
# answers 503) — 0 is honoured literally and is never silently replaced by a
# default. Quota is refunded when a call fails for reasons that are not the
# caller's fault (Google 5xx, timeout, revoked key).
#
# Why the nearby/details caps are so much lower than the geocode cap:
#
#   * /api/nearby requests rating, userRatingCount and priceLevel. Those are
#     ENTERPRISE-tier fields, so EVERY nearby search bills at the Nearby Search
#     Enterprise SKU. Google's free allowance for that SKU is 1,000 calls per
#     MONTH (~33/day), after which it is roughly $35 per 1,000 calls.
#
#   * /api/place requests reviews, which is an ATMOSPHERE field. That pushes
#     place details to the Place Details Enterprise + Atmosphere SKU: again
#     1,000 free calls per MONTH, then roughly $40 per 1,000 calls.
#
#     30/day x ~31 days = 930 calls/month, which keeps both endpoints just
#     inside the free monthly allowance. Raise these only if you accept that
#     every call above ~33/day is billed.
#
#   * Geocoding is an Essentials-tier SKU with a much larger free allowance
#     (~10,000 calls/month), so 200/day is safe.
#
#   * /api/photo hits the Place Photo SKU (Essentials tier). Proxied photos are
#     cached by the browser for a day via cache-control, so 300/day is generous.
#
NEARBY_DAILY_CAP=30
PLACE_DETAILS_DAILY_CAP=30
GEOCODE_DAILY_CAP=200
PHOTO_DAILY_CAP=300

# ---------------------------------------------------------------------------
# THE ONE COST YOU CANNOT CAP HERE
#
# Maps JavaScript API "map loads" are billed by Google when the BROWSER loads a
# map. That happens in the user's browser, not in this process, so no amount of
# application code can limit it — a bot hammering your page reloads bills you.
#
# You MUST cap it in Google Cloud Console:
#   APIs & Services -> Maps JavaScript API -> Quotas
#     -> "Map loads per day"    set a hard daily ceiling (e.g. 1000)
#     -> "Map loads per minute" set a burst ceiling (e.g. 60)
#   Also set a Billing budget alert on the project.
#
# Map loads are Essentials tier: ~10,000 free loads/month, then ~$7 per 1,000.
# Without a Cloud Console quota, a single scripted reload loop is what turns a
# $0/month project into a $615/month invoice.
# ---------------------------------------------------------------------------


# --- seed account (optional) ----------------------------------------------
#
# On first run the server creates one account so the login page is usable
# immediately. If SEED_PASSWORD is unset a random one is generated and printed
# to the console exactly once. Changing these later has no effect, because the
# account already exists.
SEED_NAME=Admin
SEED_EMAIL=admin@businessfind.local
SEED_PASSWORD=
